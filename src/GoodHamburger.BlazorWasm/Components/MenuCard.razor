@using GoodHamburger.Shared.DTOs

<div class="card shadow-sm h-100">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start">
            <h5 class="card-title">@Item.Nome</h5>
            <span class="badge bg-secondary">@Item.Tipo.ToString()</span>
        </div>
        <p class="card-text text-primary fw-bold mt-2">
            R$ @Item.PrecoUnitario.ToString("F2")
        </p>
        <button class="btn btn-outline-primary mt-auto w-100"
                @onclick="() => OnAdicionar.InvokeAsync(Item)">
            <i class="bi bi-plus-lg"></i> Adicionar
        </button>
    </div>
</div>

@code {
    [Parameter] public ItemCardapioDto Item { get; set; } = default!;
    [Parameter] public EventCallback<ItemCardapioDto> OnAdicionar { get; set; }
}