@using GoodHamburger.Shared.DTOs
<div class="col-md-4 mb-4">
    <div class="card h-100 border-danger shadow-lg">
        <div class="card-body text-center">
            <div class="badge bg-danger mb-2 p-2" style="font-size: 1.2rem;">
                @(Promocao.Percentual.ToString("P0")) OFF
            </div>

            <h4 class="card-title fw-bold">@Promocao.Nome</h4>

            <p class="text-muted small">
                Para ganhar, seu pedido deve conter:
            </p>

            <hr />

            <div class="d-flex flex-wrap justify-content-center gap-2">
                @foreach (var req in Promocao.Requisitos)
                {
                    <span class="badge rounded-pill bg-warning text-dark">
                        @req.ToString()
                    </span>
                }
            </div>
        </div>

        <div class="card-footer bg-transparent border-0 pb-3 text-center">
            <button class="btn btn-outline-danger" @onclick="IrParaHome">
                Aproveitar Agora
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public PromocaoDto Promocao { get; set; }

    [Inject]
    NavigationManager Nav { get; set; }

    void IrParaHome()
    {
        Nav.NavigateTo("/");
    }
}