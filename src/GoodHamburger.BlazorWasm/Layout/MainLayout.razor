@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using GoodHamburger.BlazorWasm.Security
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-3 px-md-4 d-flex justify-content-between align-items-center">

            <div class="flex-shrink-0 me-2">
                <a href="https://github.com/esdraslimaff/Good-Hamburger" target="_blank">Github</a>
            </div>

            <div class="d-flex align-items-center justify-content-end flex-grow-1" style="min-width: 0;">
                <AuthorizeView>
                    <Authorized>
                        <span class="me-2 text-dark text-truncate" title="@context.User.Identity.Name">
                            Olá, @context.User.Identity.Name!
                        </span>

                        <button class="btn btn-outline-danger btn-sm flex-shrink-0" @onclick="Sair">Sair</button>
                    </Authorized>
                    <NotAuthorized>
                        <a href="login" class="btn btn-primary btn-sm flex-shrink-0">Fazer Login</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>

        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private void Sair()
    {
        var customAuthStateProvider = (CustomAuthStateProvider)AuthStateProvider;
        customAuthStateProvider.MarcarUsuarioComoDeslogado();

        Nav.NavigateTo("/", true);
    }
}