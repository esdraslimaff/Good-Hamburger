@page "/pedidos/{Id:guid}"

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <h4>Pedido Confirmado! 🎉</h4>
        </div>
        <div class="card-body">
            @if (Pedido == null)
            {
                <p>Carregando detalhes do pedido...</p>
            }
            else
            {
                <p><strong>Protocolo:</strong> @Pedido.Id</p>
                <p><strong>Data:</strong> @Pedido.DataCriacao.ToString("dd/MM/yyyy HH:mm")</p>

                <hr />
                <h5>Itens:</h5>
                <ul class="list-group mb-3">
                    @foreach (var item in Pedido.Itens)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            @item.Nome
                            <span>R$ @item.PrecoUnitario.ToString("F2")</span>
                        </li>
                    }
                </ul>

                <div class="text-end">
                    <p>Subtotal: R$ @Pedido.Subtotal.ToString("F2")</p>
                    <p class="text-success">
                        Desconto (@Pedido.DescontoPercentual.ToString("P0")):
                        - R$ @Pedido.ValorDesconto.ToString("F2")
                    </p>
                    <h4 class="fw-bold text-primary">Total Final: R$ @Pedido.TotalFinal.ToString("F2")</h4>
                </div>
            }
        </div>
        <div class="card-footer">
            <button class="btn btn-primary" @onclick="VoltarParaHome">Novo Pedido</button>
            <button class="btn btn-secondary" @onclick="IrParaPedidos">Ver pedidos</button>
        </div>
    </div>
</div>