@page "/usuarios/novo"
@attribute [Authorize(Roles = "Admin")] 
@using GoodHamburger.Domain.Enums
@using Microsoft.AspNetCore.Authorization

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Cadastrar Novo Funcionário</h4>
        </div>
        <div class="card-body">

            @if (!string.IsNullOrEmpty(MensagemSucesso))
            {
                <div class="alert alert-success">@MensagemSucesso</div>
            }
            @if (!string.IsNullOrEmpty(MensagemErro))
            {
                <div class="alert alert-danger">@MensagemErro</div>
            }

            <EditForm Model="novoUsuario" OnValidSubmit="SalvarUsuario">
                <DataAnnotationsValidator />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Nome Completo</label>
                        <InputText @bind-Value="novoUsuario.Nome" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">E-mail</label>
                        <InputText @bind-Value="novoUsuario.Email" type="email" class="form-control" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Senha Provisória</label>
                        <InputText @bind-Value="novoUsuario.Senha" type="password" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Perfil de Acesso</label>
                        <InputSelect @bind-Value="novoUsuario.Perfil" class="form-select">
                            @foreach (var perfil in Enum.GetValues(typeof(TipoPerfil)))
                            {
                                <option value="@((int)perfil)">@perfil.ToString()</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button type="button" class="btn btn-secondary" @onclick="Voltar">Cancelar</button>
                    <button type="submit" class="btn btn-success" disabled="@Salvando">
                        @if (Salvando)
                        {
                            <span class="spinner-border spinner-border-sm"></span> <span>Salvando...</span>
                        }
                        else
                        {
                            <span>Cadastrar Usuário</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>