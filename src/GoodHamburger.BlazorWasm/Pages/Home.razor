@page "/"
@inherits HomeBase
@using GoodHamburger.BlazorWasm.Components

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h3 class="mb-4">Cardápio Good Hamburger 🍔</h3>

            @if (ItensCardapio == null)
            {
                <div class="d-flex justify-content-center my-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            }
            else
            {
                @foreach (var grupo in ItensAgrupados)
                {
                    <h5 class="mt-4 border-bottom pb-2">@grupo.Key.ToString()s</h5>
                    <div class="row">
                        @foreach (var item in grupo)
                        {
                            <div class="col-md-6 mb-3">
                                <MenuCard Item="@item" OnAdicionar="AdicionarAoCarrinho" />
                            </div>
                        }
                    </div>
                }
            }
        </div>

        <div class="col-md-4">
                <CarrinhoResumo ItensNoCarrinho="Carrinho"
                                Resumo="Resumo"
                                Processando="Processando"
                                MensagemErro="@MensagemErro"
                                OnRemover="RemoverDoCarrinho"
                                OnFinalizar="FinalizarPedido" />
        </div>
    </div>
</div>