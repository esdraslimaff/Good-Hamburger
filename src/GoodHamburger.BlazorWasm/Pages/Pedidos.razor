@page "/pedidos"

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Histórico de Pedidos 📋</h3>
        <button class="btn btn-primary" @onclick="IrParaNovoPedido">Novo Pedido</button>
    </div>

    @if (ListaPedidos == null)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status"></div>
            <p>Carregando histórico...</p>
        </div>
    }
    else if (!ListaPedidos.Any())
    {
        <div class="alert alert-info text-center">
            Nenhum pedido registrado até o momento. <br />
            <button class="btn btn-link" @onclick="IrParaNovoPedido">Que tal fazer o primeiro?</button>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle shadow-sm bg-white">
                <thead class="table-dark">
                    <tr>
                        <th>Data</th>
                        <th>Itens</th>
                        <th>Subtotal</th>
                        <th>Desconto</th>
                        <th>Total Final</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pedido in ListaPedidos.OrderByDescending(p => p.DataCriacao))
                    {
                        <tr>
                            <td>
                                <small class="text-muted">@pedido.DataCriacao.ToString("dd/MM/yyyy")</small><br />
                                <strong>@pedido.DataCriacao.ToString("HH:mm")</strong>
                            </td>
                            <td>
                                @foreach (var item in pedido.Itens)
                                {
                                    <span class="badge bg-light text-dark border me-1">@item.Nome</span>
                                }
                            </td>
                            <td>R$ @pedido.Subtotal.ToString("F2")</td>
                            <td>
                                @if (pedido.DescontoPercentual > 0)
                                {
                                    <span class="text-success small">
                                        -R$ @pedido.ValorDesconto.ToString("F2")
                                        <br />(@pedido.DescontoPercentual.ToString("P0"))
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">Sem desconto</span>
                                }
                            </td>
                            <td class="fw-bold text-primary">R$ @pedido.TotalFinal.ToString("F2")</td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-outline-info"
                                            @onclick="() => VerDetalhes(pedido.Id)">
                                        Detalhes
                                    </button>

                                    <button class="btn btn-sm btn-outline-warning"
                                            @onclick="() => IrParaEditar(pedido.Id)">
                                        Editar
                                    </button>

                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => ConfirmarExclusao(pedido.Id)">
                                        Excluir
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>