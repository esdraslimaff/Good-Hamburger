@page "/pedidos/editar/{Id:guid}"
@using GoodHamburger.Shared.DTOs
@using GoodHamburger.BlazorWasm.Components
@inject GoodHamburger.BlazorWasm.Services.Interfaces.IPedidoService PedidoService
@inject GoodHamburger.BlazorWasm.Services.Interfaces.ICardapioService CardapioService
@inject NavigationManager Nav

<div class="container mt-4">
    @if (Carregando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Montando sua bandeja...</p>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold">Editar Pedido 🍔</h3>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="Voltar">Cancelar</button>
                </div>

                @foreach (var grupo in ItensAgrupados)
                {
                    <h5 class="text-muted border-bottom pb-2 mt-4">
                        @grupo.Key.ToString()s
                    </h5>

                    <div class="row g-3">
                        @foreach (var item in grupo)
                        {
                            <div class="col-md-6">
                                <MenuCard Item="item"
                                          OnAdicionar="AdicionarAoCarrinho" />
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="col-md-4">
                <div class="sticky-top" style="top: 20px;">
                    <CarrinhoResumo ItensNoCarrinho="ItensNoCarrinho"
                                    Processando="Processando"
                                    MensagemErro="@MensagemErro"
                                    OnRemover="RemoverDoCarrinho"
                                    OnFinalizar="SalvarAlteracoes" />
                </div>
            </div>
        </div>
    }
</div>