@page "/login"

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header bg-dark text-white text-center">
                    <h4 class="mb-0">Área Restrita 🍔</h4>
                </div>
                <div class="card-body p-4">

                    @if (!string.IsNullOrEmpty(MensagemErro))
                    {
                        <div class="alert alert-danger p-2 small">
                            @MensagemErro
                        </div>
                    }

                    <EditForm Model="loginRequest" OnValidSubmit="FazerLogin">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label">E-mail</label>
                            <InputText @bind-Value="loginRequest.Email" class="form-control" placeholder="admin@goodhamburger.com" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Senha</label>
                            <InputText @bind-Value="loginRequest.Senha" type="password" class="form-control" placeholder="******" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-bold" disabled="@Carregando">
                            @if (Carregando)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Entrando...</span>
                            }
                            else
                            {
                                <span>Entrar</span>
                            }
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>