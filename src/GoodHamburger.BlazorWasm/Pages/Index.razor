@page "/"
@using GoodHamburger.Domain.Enums
@using GoodHamburger.Shared.DTOs
@using GoodHamburger.BlazorWasm.Services.Interfaces
@inject ICardapioService CardapioService

<div class="container mt-4">
    <div class="text-center mb-5">
        <h2 class="display-5 fw-bold text-primary">Nosso Cardápio 🍔</h2>
        <p class="lead">Conheça as delícias da Good Hamburger.</p>
    </div>

    @if (ItensCardapio == null)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var grupo in ItensAgrupados)
            {
                <h4 class="mt-4 border-bottom pb-2 text-secondary">@grupo.Key.ToString()s</h4>

                @foreach (var item in grupo)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card shadow-sm h-100 border-0 bg-light">
                            <div class="card-body">
                                <h5 class="card-title fw-bold">@item.Nome</h5>
                                <p class="card-text text-success fs-5 fw-bold">R$ @item.PrecoUnitario.ToString("F2")</p>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    private List<ItemCardapioDto> ItensCardapio;
    private IEnumerable<IGrouping<TipoItem, ItemCardapioDto>> ItensAgrupados =>
            ItensCardapio?.GroupBy(x => x.Tipo) ?? Enumerable.Empty<IGrouping<TipoItem, ItemCardapioDto>>();

    protected override async Task OnInitializedAsync()
    {
        ItensCardapio = await CardapioService.GetItensAsync();
    }
}